# --- App ---
NEXT_PUBLIC_APP_NAME=Commently
# Public HTTPS URL of this app (no trailing slash). Instagram needs HTTPS for the OAuth redirect + webhook.
# Local dev: run `ngrok http 3000` (or cloudflared) and paste the https URL here.
APP_URL=https://your-domain.com

# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:root@localhost:5432/commently

# --- Secrets (generate: openssl rand -hex 32) ---
AUTH_SECRET=change-me-64-hex-chars
# Must be exactly 64 hex chars (32 bytes). Used to encrypt Instagram access tokens at rest.
ENCRYPTION_KEY=change-me-64-hex-chars
# Protects /api/cron/refresh-tokens
CRON_SECRET=change-me-long-random-string

# --- Meta / Instagram (Meta App Dashboard > Instagram > API setup with Instagram login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any string you choose. Paste the same value in the Meta webhook "Verify token" field.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# --- Shopify (Partner dashboard > Apps > your app > Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Read-only: products + stock. Must match the scopes configured on the app in the Partner dashboard.
SHOPIFY_SCOPES=read_products,read_inventory
# Admin API version used for catalogue sync (quarterly releases, supported ~12 months)
SHOPIFY_API_VERSION=2026-07
# Set to true once webhooks are managed by shopify.app.toml (`shopify app deploy`). Leave empty to let the app register them itself.
SHOPIFY_MANAGED_WEBHOOKS=

# --- AI replies (Google Gemini: aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Tried first; falls back to other flash models automatically (see src/lib/ai.ts)
GEMINI_MODEL=

# Comma-separated emails that may see technical screens (webhook deliveries, Meta/Shopify setup values). Everyone else only sees merchant-facing pages.
ADMIN_EMAILS=
